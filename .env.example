# --- Database ---
# When running via docker-compose, only POSTGRES_USER/PASSWORD/DB are needed;
# DATABASE_URL is assembled automatically. For a bare `npm run dev` against a
# Postgres instance you already have, set DATABASE_URL directly instead.
POSTGRES_USER=uaepcs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=uaepcs
DATABASE_URL=postgresql://uaepcs:change-me@localhost:5432/uaepcs

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me

# --- Facebook Lead Ads / Messenger webhook ---
# App Dashboard > Webhooks. Verify token is any string you choose; App Secret
# is used to check the X-Hub-Signature-256 header on incoming events.
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_APP_SECRET=

# --- Instagram Messaging webhook (same Meta App as Facebook, usually) ---
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=

# --- WhatsApp Cloud API webhook ---
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- LinkedIn Lead Gen Forms (via Zapier/Make/n8n bridge) ---
LINKEDIN_WEBHOOK_API_KEY=

# --- Generic webhook ingestion (trade shows, ERP, other automations) ---
GENERIC_WEBHOOK_API_KEY=
