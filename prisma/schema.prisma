generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Staff / Auth ----------

enum StaffRole {
  ADMIN
  SALES
  SUPPORT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         StaffRole @default(SALES)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedLeads Lead[]         @relation("LeadAssignee")
  assignedTasks Task[]         @relation("TaskAssignee")
  activities    LeadActivity[] @relation("ActivityAuthor")

  @@map("users")
}

// ---------- CRM: Customers ----------

enum CustomerType {
  RETAIL
  WHOLESALE
  EXPORT
}

model Customer {
  id          String       @id @default(cuid())
  companyName String
  contactName String?
  email       String?
  phone       String?
  country     String?
  type        CustomerType @default(RETAIL)
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  leads Lead[]

  @@map("customers")
}

// ---------- Workflow Engine: Leads ----------

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  QUOTED
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  LINKEDIN
  EMAIL
  PHONE
  REFERRAL
  TRADE_SHOW
  OTHER
}

model Lead {
  id               String     @id @default(cuid())
  contactName      String
  companyName      String?
  email            String?
  phone            String?
  country          String?
  message          String?
  productInterest  String?
  estimatedValueAed Decimal?  @db.Decimal(12, 2)

  source     LeadSource @default(WEBSITE)
  sourceRef  String?    // external id/thread id from the originating channel
  stage      LeadStage  @default(NEW)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities LeadActivity[]
  tasks      Task[]

  @@index([stage])
  @@index([source])
  @@map("leads")
}

enum ActivityType {
  STAGE_CHANGE
  NOTE
  EMAIL
  CALL
  TASK_CREATED
  SYSTEM
}

model LeadActivity {
  id        String       @id @default(cuid())
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      ActivityType
  message   String
  metadata  Json?

  createdById String?
  createdBy   User?   @relation("ActivityAuthor", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("lead_activities")
}

// ---------- Tasks ----------

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(OPEN)
  dueAt       DateTime?

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("TaskAssignee", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([leadId])
  @@map("tasks")
}

// ---------- Product Catalog ----------

enum ProductCategory {
  NETWORKING
  HARDWARE
  CONSUMABLES
  INFRASTRUCTURE
  OTHER
}

model Product {
  id             String          @id @default(cuid())
  sku            String          @unique
  name           String
  category       ProductCategory @default(OTHER)
  description    String?
  unit           String          @default("pcs")
  wholesalePrice Decimal?        @db.Decimal(12, 2)
  retailPrice    Decimal?        @db.Decimal(12, 2)
  stockQty       Int             @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("products")
}

// ---------- External Integrations ----------

model IntegrationSource {
  id            String     @id @default(cuid())
  channel       LeadSource
  label         String
  webhookSecret String?
  isActive      Boolean    @default(true)
  config        Json?
  lastEventAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([channel, label])
  @@map("integration_sources")
}
